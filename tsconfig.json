{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "types": ["vite/client", "vitest", "node"],
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "noEmit": true
  },
  "include": ["src"]
}
